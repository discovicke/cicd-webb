{
  "name": "cicd-webb",
  "version": "1.0.0",
  "private": true,
  "description": "Statisk webbsida – övningsuppgift CI/CD vecka 1",
  "scripts": {
    "format": "prettier --write \"src/webb/index.html\" \"src/webb/styles.css\"",
    "format:check": "prettier --check \"src/webb/index.html\" \"src/webb/styles.css\"",
    "lint:css": "stylelint \"src/webb/**/*.css\"",
    "lint:css:fix": "stylelint \"src/webb/**/*.css\" --fix",
    "validate:html": "html-validate \"**/*.html\"",
    "validate:html:fix": "html-validate --fix \"**/*.html\"",
    "check": "npm run validate:html && npm run lint:css && npm run format:check",
    "fix": "npm run validate:html:fix && npm run lint:css:fix && npm run format"
  },
  "devDependencies": {
    "html-validate": "^11.16.2",
    "prettier": "^3.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
