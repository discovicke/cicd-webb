{
  "name": "cicd-webb",
  "version": "1.0.0",
  "private": true,
  "description": "Statisk webbsida – övningsuppgift CI/CD vecka 1",
  "scripts": {
    "format": "prettier --write \"src/webb/index.html\" \"src/webb/styles.css\"",
    "format:check": "prettier --check \"src/webb/index.html\" \"src/webb/styles.css\"",
    "validate:html": "html-validate \"**/*.html\""
    
  },
  "devDependencies": {
    "html-validate": "^11.16.2",
    "prettier": "^3.6.2"
  }
}
