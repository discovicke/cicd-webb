{
  "name": "cicd-webb",
  "version": "1.0.0",
  "private": true,
  "description": "Statisk webbsida – övningsuppgift CI/CD vecka 1",
  "scripts": {
    "prettier": "prettier --check \"src/webb/index.html\" \"src/webb/styles.css\"",
    "prettier:fix": "prettier --write \"src/webb/index.html\" \"src/webb/styles.css\"",
    "stylelint": "stylelint \"src/webb/**/*.css\"",
    "stylelint:fix": "stylelint \"src/webb/**/*.css\" --fix",
    "htmlvalidate": "html-validate \"**/*.html\"",
    "htmlvalidate:fix": "html-validate --fix \"**/*.html\"",
    "check": "npm run htmlvalidate && npm run stylelint && npm run prettier",
    "fix": "npm run htmlvalidate:fix && npm run stylelint:fix && npm run prettier:fix"
  },

  "devDependencies": {
    "html-validate": "^11.16.2",
    "prettier": "^3.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
